+(require 'gnus-group)
 
 ;;}}}
 ;;{{{ IMap Search Operators:
@@ -128,7 +129,13 @@
 ;;}}}
 ;;{{{ NNIR Engine For GMail 
 
-;;; GMail Search Commands 
+;;; GMail Search Commands
+
+(defvar gm-nnir-make-group-function
