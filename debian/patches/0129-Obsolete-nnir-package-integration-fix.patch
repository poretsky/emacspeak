 ;;}}}
 ;;{{{ Forward declarations
diff --git a/lisp/g-client/gm-nnir.el b/lisp/g-client/gm-nnir.el
index ebd137e..76838fc 100644
--- a/lisp/g-client/gm-nnir.el
+++ b/lisp/g-client/gm-nnir.el
@@ -59,7 +59,8 @@
 (require 'cl-lib)
