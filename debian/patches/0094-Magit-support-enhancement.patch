+
+(defadvice magit-key-mode(after emacspeak pre act comp)
+  "Provide auditory icon."
+  (setq header-line-format
+        '(:eval (emacspeak-magit-key-mode-header-line)))
+  (emacspeak-auditory-icon 'open-object))
 
