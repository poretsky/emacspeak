+(cl-declaim  (optimize  (safety 0) (speed 3)))
+(require 'emacspeak-preamble)
+;;}}}
+;;{{{  Introduction:
+
+;;; Commentary:
+;;; find-dired is an emacs package for using UNIX find from emacs.
