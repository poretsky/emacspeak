diff --git a/lisp/emacspeak-autoload.el b/lisp/emacspeak-autoload.el
index b332cef..bbe35c1 100644
--- a/lisp/emacspeak-autoload.el
+++ b/lisp/emacspeak-autoload.el
@@ -46,7 +46,7 @@
 ;;{{{  Required modules
 
 (require 'cl-lib)
-(require 'autoload)
+
 ;;}}}
 ;;{{{ Variables
 
@@ -76,10 +76,14 @@ Emacspeak.")
   "Generate emacspeak autoloads."
   (cl-declare (special  emacspeak-auto-autoloads-file
                         emacspeak-update-autoloads-from-directories emacspeak-lisp-directory))
-  (let ((dtk-quiet t)
-        (generated-autoload-file emacspeak-auto-autoloads-file))
-    (funcall emacspeak-update-autoloads-from-directories
-             emacspeak-lisp-directory)))
+  (cond
+   ((locate-library "loaddefs-gen")     ; emacs 29
+    (loaddefs-generate emacspeak-lisp-directory "emacspeak-loaddefs.el" nil nil nil t))
+   (t (require 'autoload)
+      (let ((dtk-quiet t)
+            (generated-autoload-file emacspeak-auto-autoloads-file))
+        (funcall emacspeak-update-autoloads-from-directories
+                 emacspeak-lisp-directory)))))
 
 ;;}}}
