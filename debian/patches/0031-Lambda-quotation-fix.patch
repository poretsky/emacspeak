From: "Igor B. Poretsky" <poretsky@mlbox.ru>
Date: Tue, 18 Aug 2026 20:23:29 +0300
Subject: Lambda quotation fix

---
 lisp/g-utils.el     | 2 +-
 lisp/voice-setup.el | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/lisp/g-utils.el b/lisp/g-utils.el
index 0552cdd..9ed2b4e 100644
--- a/lisp/g-utils.el
+++ b/lisp/g-utils.el
@@ -100,7 +100,7 @@ Receives buffer containing HTML as its argument.")
   "Cookie jar used for Google services.
 Customize this to live on your local disk."
   :type 'file
-  :set '(lambda (sym val)
+  :set #'(lambda (sym val)
           (cl-declare (special g-cookie-options))
           (setq g-cookie-options
                 (format "--cookie %s --cookie-jar %s"
diff --git a/lisp/voice-setup.el b/lisp/voice-setup.el
index 3b2fcae..dece9c1 100644
--- a/lisp/voice-setup.el
+++ b/lisp/voice-setup.el
@@ -290,7 +290,7 @@ command \\[customize-variable] on <personality>-settings. "
                         (const :tag "No punctuations" none)))
        :group 'voice-fonts
        :set
-       '(lambda  (sym val)
+       #'(lambda  (sym val)
           (let ((voice-name (voice-setup-personality-from-style val)))
             (setq ,personality voice-name)
 ;;; update all observers
